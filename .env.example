# Configuración de Supabase (Obtén estos valores en Supabase Dashboard -> Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key-publica

# Opcional: Service Role Key para operaciones de servidor sin restricciones de RLS
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key-secreta
